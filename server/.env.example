# ===================================================
# ZAMYAA BY JYOTI — PRODUCTION CONFIGURATION TEMPLATE
# ===================================================

# Server Runtime
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://zamyaa.in

# Security & Authentication (JWT Secrets)
# Generate strong keys in production (e.g. openssl rand -base64 48)
JWT_SECRET=zamyaa_luxury_production_editorial_jwt_secret_2026_xyz
JWT_REFRESH_SECRET=zamyaa_luxury_refresh_jwt_secret_2026_xyz

# Initial Administrator Credentials (used by `npm run seed:admin`)
ADMIN_NAME="Jyoti Sharma"
ADMIN_EMAIL=admin@zamyaa.in
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_2026!

# Database Persistence (MongoDB Atlas Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/zamyaa?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary Media Storage (Active cloud: c8deakbl)
CLOUDINARY_CLOUD_NAME=c8deakbl
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway (Indian Rupee INR)
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

